# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/

# Data — raw reference outputs are large and external; keep out of git.
# The whole tree, not just the known subfolders: a fresh drop landing loose in
# data/ is ~6 MB per snapshot and must not be committable by accident.
data/

# Experiment outputs
runs/
checkpoints/
*.npy
*.npz

# OS
Thumbs.db
.DS_Store

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.synctex.gz

# Transient run logs — curated copies live in reports/ml_runs/
logs/
